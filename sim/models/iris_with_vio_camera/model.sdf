<?xml version='1.0'?>
<sdf version="1.9">
  <model name="iris_with_vio_camera">
    <!-- Include the base iris_with_ardupilot model -->
    <include>
      <uri>model://iris_with_ardupilot</uri>
    </include>

    <!--
      Forward camera for VIO, rigidly fixed to base_link (no gimbal).
      Gazebo cameras look along the link's +x axis, so zero rotation
      means looking straight ahead along the drone's nose.
      No image noise here: noise, blur and darkness are added later
      as stress tests, so the baseline stays clean.
    -->
    <link name='vio_camera_link'>
      <pose>0.1 0 -0.05 0 0 0</pose> <!-- 0.1m forward, 0.05m down, facing forward -->
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000001</iyy>
          <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>

      <sensor name="vio_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov> <!-- 90 degrees -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>L8</format> <!-- grayscale, as used by OpenVINS -->
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/vio/camera/image</topic>
      </sensor>
    </link>

    <joint name='vio_camera_joint' type='fixed'>
      <parent>iris_with_ardupilot::iris_with_standoffs::base_link</parent>
      <child>vio_camera_link</child>
    </joint>

    <!--
      Separate IMU for VIO, axes aligned with base_link (x forward,
      y left, z up). The ArduPilot IMU inside iris_with_standoffs is
      mounted rolled 180 deg and is left untouched for the autopilot.
      Noise-free baseline; IMU noise is added later as a stress test.
    -->
    <link name='vio_imu_link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000001</iyy>
          <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>

      <sensor name="vio_imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>200</update_rate>
        <topic>/vio/imu</topic>
      </sensor>
    </link>

    <joint name='vio_imu_joint' type='fixed'>
      <parent>iris_with_ardupilot::iris_with_standoffs::base_link</parent>
      <child>vio_imu_link</child>
    </joint>

    <!-- Ground truth pose and velocity of the drone, for measuring VIO error -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>iris_with_vio_camera</robot_base_frame>
      <odom_publish_frequency>100</odom_publish_frequency>
      <odom_topic>/vio/ground_truth/odom</odom_topic>
      <dimensions>3</dimensions>
    </plugin>

  </model>
</sdf>
