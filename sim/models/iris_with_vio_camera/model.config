<?xml version="1.0"?>
<model>
  <name>iris_with_vio_camera</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    iris_with_ardupilot with a rigidly mounted forward camera, a separate
    noise-free 200 Hz IMU for VIO, and a ground-truth odometry publisher.
    Used by vin_autonomy for OpenVINS testing.
  </description>
  <depend>
    <model>
      <uri>model://iris_with_ardupilot</uri>
      <version>1.0</version>
    </model>
  </depend>
</model>
